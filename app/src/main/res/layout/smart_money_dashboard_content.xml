<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_reveal_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/smart_money_dashboard_title"
        android:textColor="#EAECEF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/smart_money_dashboard_subtitle"
        android:textColor="#8A96A3"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- Card 1: live count of all active liquidity zones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_smart_money_card"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_money_zone_count_label"
            android:textColor="#8A96A3"
            android:textSize="12sp"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/zoneCountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#EAECEF"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="142" />

        <TextView
            android:id="@+id/zoneCountBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A96A3"
            android:textSize="12sp"
            tools:text="76 bid · 66 ask" />
    </LinearLayout>

    <!-- Card 2: single strongest zone (highest intensity price level) -->
    <LinearLayout
        android:id="@+id/strongestZoneCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_smart_money_card"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/smart_money_strongest_zone_label"
                android:textColor="#8A96A3"
                android:textSize="12sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/strongestZoneSideChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="BID" />
        </LinearLayout>

        <TextView
            android:id="@+id/strongestZonePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#EAECEF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="66,842.5" />

        <TextView
            android:id="@+id/strongestZoneVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A96A3"
            android:textSize="12sp"
            tools:text="18.42 BTC resting · seen 41s" />

        <LinearLayout
            android:id="@+id/strongestZoneIntensityTrack"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="1"
            android:background="@drawable/bg_intensity_track">

            <View
                android:id="@+id/strongestZoneIntensityFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.72"
                android:background="@drawable/bg_intensity_fill" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.28" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card 3: single highest-priority shelf (merged run of adjacent zones) -->
    <LinearLayout
        android:id="@+id/strongestShelfCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_smart_money_card"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/smart_money_strongest_shelf_label"
                android:textColor="#8A96A3"
                android:textSize="12sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/strongestShelfSideChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ASK" />
        </LinearLayout>

        <TextView
            android:id="@+id/strongestShelfRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#EAECEF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="67,120 – 67,180" />

        <TextView
            android:id="@+id/strongestShelfVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A96A3"
            android:textSize="12sp"
            tools:text="64.90 BTC across 6 levels" />

        <LinearLayout
            android:id="@+id/strongestShelfIntensityTrack"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="1"
            android:background="@drawable/bg_intensity_track">

            <View
                android:id="@+id/strongestShelfIntensityFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:background="@drawable/bg_intensity_fill" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.45" />
        </LinearLayout>

        <TextView
            android:id="@+id/strongestShelfProximityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8A96A3"
            android:textSize="11sp"
            tools:text="Near price · priority-ranked #1 of 5 shelves" />
    </LinearLayout>

    <TextView
        android:id="@+id/smartMoneyEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/smart_money_empty_state"
        android:textColor="#8A96A3"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/smart_money_footnote"
        android:textColor="#4E5762"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
